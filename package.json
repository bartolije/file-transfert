{
  "name": "file-transfert",
  "productName": "File Transfert",
  "version": "0.1.0",
  "description": "Client FTP / SFTP / S3 pour macOS qui reprend les favoris Cyberduck",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/bartolije/file-transfert.git"
  },
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test.js",
    "app": "electron-packager . \"File Transfert\" --platform=darwin --arch=arm64 --out=dist --overwrite --ignore=^/(dist|scripts|\\.github|\\.githooks|test\\.js)"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/lib-storage": "^3.1167.0",
    "basic-ftp": "^6.2.6",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.3.1"
  }
}
